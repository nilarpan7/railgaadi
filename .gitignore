# =============================================================
# RailGaadi (Next.js 16 + TypeScript) — .gitignore
# =============================================================

# ---------- Dependencies ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts

# ---------- Next.js build output ----------
/.next/
/out/
/build
tsconfig.tsbuildinfo

# ---------- Environment variables ----------
# Never commit real secrets. Only commit a safe example template.
.env
.env.*
!.env.example
# Local-only overrides (highest precedence, machine-specific)
.env.local
.env.*.local

# ---------- Testing / Coverage ----------
/coverage
/playwright-report/
/test-results/
*.lcov

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
logs/
*.log

# ---------- Vercel ----------
.vercel

# ---------- Docker ----------
# Ignore runtime artifacts; Dockerfile and .dockerignore are tracked.
docker-compose.override.yml

# ---------- Map debugging scratchpad (maptest/) ----------
# Playwright scripts, HTML fixtures, local node_modules, PNG screenshots.
# Not part of the app; exclude entirely to keep the repo clean.
/maptest/

# ---------- Dev scratch ----------
/implementation_plan.md

# ---------- Misc / OS ----------
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.p12
*.key
*.crt

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.pytest_cache/
