# ============================================================
# RailGaadi environment variables
# Copy to `.env.local` and fill in real values. NEVER commit
# `.env.local` — it holds live secrets.
# ============================================================

# --- App ---
# Public origin of the deployed app (used for OG metadata + auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- RailRadar (live train data) ---
# Server-side key (keep secret, never prefix with NEXT_PUBLIC_)
RAILRADAR_API_KEY=
# Optional override of the default upstream base URL
NEXT_PUBLIC_RAILRADAR_BASE=https://api.railradar.in/v1

# --- MapTiler (vector basemaps) ---
# Public key — safe for the browser bundle; enable domain restrictions
# on the MapTiler console so it only works from your host.
NEXT_PUBLIC_MAPTILER_KEY=

# --- OpenWeatherMap (primary weather source) ---
# Server-side key (keep secret, never prefix with NEXT_PUBLIC_)
OPENWEATHER_API_KEY=

# --- Open Topo Data (elevation profiles, key-free) ---
OPENTOPO_BASE=https://api.opentopodata.org/v1

# --- Shared cache (Redis via Upstash REST) ---
# Optional but recommended for multi-instance deployments. When unset the app
# falls back to a per-process in-memory cache (single-flight, bounded size) —
# correct for one instance, but every instance behind a load balancer would
# re-fetch the same upstream data independently.
# Sign up at https://console.upstash.com for a free instance, then:
#   UPSTASH_REDIS_REST_URL=https://...upstash.io
#   UPSTASH_REDIS_REST_TOKEN=...
# (For a standard REDIS_URL deployment, install `ioredis` and implement the
# Cache adapter in src/lib/cache.ts.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Logging ---
# One of: debug | info | warn | error (defaults to info in production)
# In production the logger emits newline-delimited JSON; elsewhere it's human
# readable. LOG_LEVEL=debug is useful when tracing request ids end to end.
LOG_LEVEL=

# --- NextAuth (authentication) ---
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth — set to '' to disable the button behaviour gracefully
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth — set to '' to disable the button behaviour gracefully
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
